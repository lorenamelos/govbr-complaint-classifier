# Copy to .env and fill in. Never commit .env.

# Google Play package of the gov.br app. Verify on the store page before the first collection.
PLAY_APP_ID=br.gov.meugovbr
PLAY_LANG=pt
PLAY_COUNTRY=br

# Prediction log store (ADR-17). Local SQLite works for development.
DATABASE_URL=sqlite:///./data/local/predictions.db

# Salt for hashing input text before logging (ADR-17). Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
TEXT_HASH_SALT=

# Where the served model artifact lives, and the hash it must match (ADR-13 integrity).
MODEL_DIR=./models/current
MODEL_SHA256=

# LLM used only offline: training-set labeling and the cost benchmark (ADR-19, ADR-20).
ANTHROPIC_API_KEY=

# API protection (ADR-18)
RATE_LIMIT=30/minute
# TEMPORARY: 1 logs the shape of IP headers on /v1/ calls, never their values.
RATE_LIMIT_DIAGNOSTICS=0
MAX_BATCH_SIZE=50

LOG_LEVEL=INFO
